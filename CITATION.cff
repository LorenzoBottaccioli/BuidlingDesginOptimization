cff-version: 1.2.0
message: "If you use bdopt in your work, please cite it as below."
title: "bdopt: building design optimization with EnergyPlus"
type: software
version: 0.1.0
license: MIT
repository-code: "https://github.com/lorenzobottaccioli/buidlingdesginoptimization"
abstract: >-
  Python library for building design optimization with EnergyPlus: parametric studies,
  adaptive sampling, surrogate models and multi-objective optimization.
keywords:
  - EnergyPlus
  - building energy simulation
  - surrogate modelling
  - adaptive sampling
  - multi-objective optimization
authors:
  - name: "bdopt contributors"
references:
  - type: software
    title: "BESOS: a library for Building and Energy Simulation, Optimization and Surrogate-modelling"
    authors:
      - family-names: "Evins"
        given-names: "Ralph"
      - name: "BESOS contributors"
    repository-code: "https://gitlab.com/energyincities/besos"
    notes: "The bdopt API is inspired by BESOS (GPL-3.0). No BESOS code is included in bdopt."
