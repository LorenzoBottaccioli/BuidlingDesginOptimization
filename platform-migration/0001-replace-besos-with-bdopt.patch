new file mode 100644
index 0000000..3d8c449
--- /dev/null
+++ b/conda-environment/surrogate/Dockerfile
@@ -0,0 +1,46 @@
+###############################################
+# Surrogate-modelling image (bdopt)           #
+# Replaces BESOS + harlow + TensorFlow.       #
+# EnergyPlus is installed inside the image,   #
+# so the notebooks do not depend on the       #
+# 'energyplus' container.                     #
+###############################################
+FROM python:3.11-slim
+
+# Any EnergyPlus >= 8.7 works; it must match the version of the uploaded IDF (or enable auto_upgrade).
+ARG EPLUS_VERSION=9.6
+# Where to get bdopt from: a git URL, a PyPI name, or a wheel/sdist copied into the build context.
+ARG BDOPT_SPEC="bdopt[torch,viz] @ git+https://github.com/lorenzobottaccioli/buidlingdesginoptimization.git"
+
+ENV DEBIAN_FRONTEND=noninteractive \
+    PIP_NO_CACHE_DIR=1 \
+    BDOPT_EPLUS_PATH=/opt/eplus
+
+RUN apt-get update && apt-get install -y --no-install-recommends \
+        git ca-certificates libx11-6 libgomp1 \
+    && rm -rf /var/lib/apt/lists/*
+
+# EnergyPlus (vendored copy of bdopt/tools/install_eplus.py: downloads the official release)
+COPY install_eplus.py /tmp/install_eplus.py
+RUN python /tmp/install_eplus.py "${EPLUS_VERSION}" --dir /opt/eplus
+
+# CPU-only PyTorch (the default PyPI wheel bundles several GB of CUDA libraries)
+RUN pip install torch --index-url https://download.pytorch.org/whl/cpu \
+    && pip install notebook ipykernel "${BDOPT_SPEC}" \
+    && python -m ipykernel install --sys-prefix --name surrogate-modeling-env \
+        --display-name "Python 3.11 (surrogate-modeling-env)"
+
+RUN mkdir -p /home/jovyan/notebooks
+WORKDIR /home/jovyan/notebooks
+EXPOSE 8888
+
+ENTRYPOINT ["/bin/bash", "-lc", \
+    "jupyter notebook \
+     --ip=0.0.0.0 \
+     --port=8888 \
+     --no-browser \
+     --allow-root \
+     --NotebookApp.token='' \
+     --NotebookApp.password='' \
+     --NotebookApp.notebook_dir=/home/jovyan/notebooks \
+     --NotebookApp.tornado_settings=\"{'headers':{'Content-Security-Policy':'frame-ancestors *'}}\""]
